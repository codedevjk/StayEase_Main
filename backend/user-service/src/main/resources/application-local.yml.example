# ─────────────────────────────────────────────────────────────────────────
# application-local.yml.example  —  TEMPLATE FILE (committed to Git)
# Copy this file to application-local.yml (git-ignored) to run locally.
# NEVER commit application-local.yml with real passwords or secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── How to generate a valid JWT secret ──────────────────────────────────
# Run this command to generate a cryptographically-random 32-byte secret:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Paste the output as the JWT_SECRET value below.
# ────────────────────────────────────────────────────────────────────────

spring:
  datasource:
    # Replace stayease_user with your local MySQL username for this service.
    # The database stayease_user_db must already be created manually.
    url: jdbc:mysql://localhost:3306/stayease_user_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: stayease_user
    password: LOCAL_DB_PASSWORD_HERE

stayease:
  jwt:
    # Paste a freshly generated Base64-encoded 256-bit key here.
    # Use the same value across all services in your local environment.
    secret: LOCAL_JWT_SECRET_BASE64_HERE

  # ── AdminBootstrapRunner ──────────────────────────────────────────────
  # To seed the first administrator account ONE TIME:
  #   1. Set enabled: true below.
  #   2. Set the desired email and a strong bootstrap password.
  #   3. Start user-service once.
  #   4. Immediately set enabled: false and restart.
  #   CAUTION: The bootstrap password is logged exactly ONCE to stdout during
  #            startup; capture it and discard. Never commit it here.
  admin-bootstrap:
    enabled: false          # Change to true ONLY for the single bootstrap run
    admin-email: admin@stayease.local
    admin-full-name: StayEase Administrator
    # Bootstrap password is generated by the runner itself if blank;
    # set a value here only during the initial bootstrap, then clear it.
    admin-password:
